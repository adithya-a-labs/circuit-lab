wien_01 - original lab topology; National Semiconductor LM741 macromodel
.include /workspace/circuit-outputs/experiment-8-lm741/models/LM741_ngspice.lib
Vpos vp 0 15
Vneg vn 0 -15
.model D4148 D(Is=2.52n Rs=0.568 N=1.752 Cjo=4p M=0.4 Tt=20n)
Rin minus 0 1k
RF out minus 2010
R1 plus 0 10000
C1 plus 0 1e-07 IC=0.05
R2 out series 10000
C2 series plus 1e-07
XU plus minus vp vn out LM741/NS
.ic v(plus)=0.05
.options reltol=1e-5 abstol=1e-10 method=gear maxord=2
.control
set wr_singlescale
set wr_vecnames
tran 8.333333333333334e-06 5.0 0 8.333333333333334e-06 
wrdata /workspace/circuit-outputs/experiment-8-lm741/simulation_data/wien_01.txt v(out) v(plus)
quit
.endc
.end
